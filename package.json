{
  "name": "clearnest",
  "version": "0.1.0",
  "description": "Family maintenance app with streaks, shopping lists, and inventory tracking",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,json}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "robot --outputdir tests/results tests/robot/",
    "test:e2e:auth": "robot --outputdir tests/results tests/robot/auth.robot",
    "test:e2e:kanban": "robot --outputdir tests/results tests/robot/kanban.robot",
    "test:e2e:shopping": "robot --outputdir tests/results tests/robot/shopping.robot",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/auth-helpers-nextjs": "^0.8.0",
    "@supabase/supabase-js": "^2.45.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.408.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-toastify": "^10.0.0",
    "swr": "^2.2.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.0",
    "zod": "^3.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.4.0",
    "prettier": "^3.1.0",
    "supabase": "^1.185.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.0"
  }
}
